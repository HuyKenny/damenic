---
import Base from '@/layouts/Base.astro';
import ShoppingList from '@/islands/ShoppingList';
import PartnerCta from '@/components/PartnerCta.astro';
import { allRecipes, ingredientInfo, recipeLite } from '@/lib/content';
import type { RecipeLite } from '@/lib/types';
import { getCollection } from 'astro:content';

const recipes: Record<string, RecipeLite> = {};
for (const r of await allRecipes()) recipes[r.id] = recipeLite(r);
const info = await ingredientInfo();
// Partners appear only when enabled and verified (partners.json); with none, nothing is shown.
const partners = (await getCollection('partners')).filter((p) => p.data.enabled && p.data.url && p.data.verifiedAt);
---

<Base title="Nákupní seznam" description="Nákupní seznam ze zvolených receptů, uložený jen v tomto prohlížeči." noindex>
  <div class="wrap statepage">
    <div class="pagehead">
      <h1>Nákupní seznam</h1>
      <p>Suroviny ze všech receptů, sečtené a roztříděné podle oddělení. Tohle je ta část, která se dá doopravdy nakoupit. Seznam se ukládá jen v tomto prohlížeči.</p>
    </div>
    <ShoppingList client:load recipes={recipes} info={info} />
    {partners[0] && <PartnerCta partner={{ id: partners[0].id, name: partners[0].data.name }} variant="list" />}
  </div>
</Base>
