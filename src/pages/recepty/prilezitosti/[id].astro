---
import HubPage from '@/components/HubPage.astro';
import { RECIPE_HUBS, type Hub } from '@/lib/hubs';

export async function getStaticPaths() {
  return (await RECIPE_HUBS()).filter((h) => h.slug.startsWith('prilezitosti/')).map((hub) => ({ params: { id: hub.slug.slice('prilezitosti/'.length) }, props: { hub } }));
}
interface Props {
  hub: Hub;
}
---

<HubPage hub={Astro.props.hub} />
