---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import RecipeBrowser from '@/islands/RecipeBrowser';
import { recipeIndex } from '@/lib/content';
import { RECIPE_HUBS } from '@/lib/hubs';
import { OCCASIONS, type OccasionId } from '@/lib/occasions';
import { CATEGORY_LABELS } from '@/lib/site';
import { EMPTY_RECIPE_FILTERS, applyRecipeFilters, facetCounts } from '@/lib/recipe-facets';

const { recipes } = await recipeIndex();
const hubs = await RECIPE_HUBS();
const occasionHubs = hubs.filter((h) => h.slug.startsWith('prilezitosti/'));
// First page (18 recipes) for the server-rendered HTML (crawlable, no layout jump); the island takes over after hydration.
const initial = applyRecipeFilters(recipes, EMPTY_RECIPE_FILTERS, new Date()).slice(0, 18);
const initialCounts = facetCounts(recipes, EMPTY_RECIPE_FILTERS);
const categories = Object.entries(CATEGORY_LABELS)
  .filter(([id]) => recipes.some((r) => r.category === id))
  .map(([id, c]) => ({ id, label: c.label }));
const kindOf = (slug: string) => slug.split('/')[0];
const groups = [
  { title: 'Podle typu jídla', items: hubs.filter((h) => kindOf(h.slug) === 'typ') },
  { title: 'Podle hlavní suroviny', items: hubs.filter((h) => kindOf(h.slug) === 'surovina') },
  { title: 'Podle stravy', items: [...hubs.filter((h) => h.slug === 'bez-masa'), ...hubs.filter((h) => kindOf(h.slug) === 'dieta'), ...hubs.filter((h) => h.slug === 'rychle')] },
  { title: 'Podle kuchyně', items: hubs.filter((h) => kindOf(h.slug) === 'kuchyne') },
  { title: 'Svátky a oslavy', items: [{ path: '/recepty/prilezitosti/', label: 'Všechny svátky' }, ...occasionHubs] },
].filter((g) => g.items.length);
const occasions = occasionHubs.map((h) => {
  const id = h.slug.slice('prilezitosti/'.length);
  return { id, label: OCCASIONS[id as OccasionId].label };
});
---

<Base
  title="Recepty na jídla z rozvozu – uvař si doma"
  description={`${recipes.length} receptů: česká klasika, polévky, pizza, dorty, cukroví, koktejly i asijská jídla. S poctivými časy, přepočtem porcí, odhadem nákladů a nákupním seznamem.`}
>
  <Breadcrumbs items={[{ label: 'Recepty' }]} />
  <div class="wrap">
    <div class="pagehead" style="max-width:640px">
      <h1>Recepty na doma</h1>
      <p>
        Skutečné recepty k jídlům ze simulátoru. Vyber podle času, stravy nebo toho, co máš doma. Ceny surovin jsou ilustrační odhady.
      </p>
    </div>
    <RecipeBrowser client:load categories={categories} occasions={occasions} total={recipes.length} initial={initial} initialCounts={initialCounts} />
    <nav class="section" aria-label="Kategorie receptů" style="padding-top:8px">
      {
        groups.map((g) => (
          <>
            <h2 style="font-size:1.125rem;margin:18px 0 10px">{g.title}</h2>
            <ul class="fpanel__chips">
              {g.items.map((h) => <li><a class="fchip" href={h.path}>{h.label}</a></li>)}
            </ul>
          </>
        ))
      }
    </nav>
  </div>
</Base>
