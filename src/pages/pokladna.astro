---
import Base from '@/layouts/Base.astro';
import Checkout from '@/islands/Checkout';
---

<Base title="Pokladna nanečisto" description="Simulovaná pokladna. Žádné platební údaje, žádná skutečná platba." noindex>
  <div class="wrap statepage">
    <div class="pagehead">
      <span class="stamp">Nanečisto</span>
      <h1 style="margin-top:10px">Pokladna</h1>
      <p>Tady se nic neplatí. Nechceme číslo karty, jméno, telefon ani adresu.</p>
    </div>
    <Checkout client:load />
  </div>
</Base>
