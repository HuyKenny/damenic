---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import RestaurantBrowser from '@/islands/RestaurantBrowser';
import { categoryIcons, restaurantSummaries } from '@/lib/content';
import { SITE } from '@/lib/site';

const summaries = await restaurantSummaries();
const cats = await categoryIcons();
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Fiktivní restaurace simulátoru DámeNic',
    url: `${SITE.url}/restaurace/`,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  },
];
---

<Base
  title="Restaurace nanečisto – filtry, kuchyně, akce"
  description={`${summaries.length} smyšlených restaurací simulátoru DámeNic: pizza, sushi, burgery, česká, thajská, indická, mexická kuchyně a dezerty. Filtry, akce a objednávka nanečisto za 0 Kč.`}
  jsonld={jsonld}
>
  <Breadcrumbs items={[{ label: 'Restaurace' }]} />
  <div class="wrap">
    <div class="pagehead">
      <h1>Restaurace</h1>
      <p>Žádná z nich neexistuje a nic z nich nepřijede. Časy, dopravné, minima i akce jsou simulované. Skutečné jsou jen recepty.</p>
    </div>
    <RestaurantBrowser client:load restaurants={summaries} categories={cats} />
  </div>
</Base>
