---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Photo from '@/components/Photo.astro';
import Icon from '@/components/Icon.astro';
import QuickAdd from '@/islands/QuickAdd';
import CartView from '@/islands/CartView';
import { ModeSwitch } from '@/islands/CartView';
import { Monogram } from '@/islands/RestaurantTile';
import { getImage } from 'astro:assets';
import { allDishes, allRestaurants, buildCatalog, dishHasPage, photo, type Restaurant } from '@/lib/content';
import { formatCzk } from '@/lib/money';
import { etaRange, hoursLabel } from '@/lib/hours';
import { CATEGORY_LABELS } from '@/lib/site';

export async function getStaticPaths() {
  return (await allRestaurants()).map((restaurant) => ({ params: { slug: restaurant.id }, props: { restaurant } }));
}
interface Props {
  restaurant: Restaurant;
}
const { restaurant: r } = Astro.props;
const dishes = (await allDishes()).filter((d) => d.data.restaurant.id === r.id);
const catalog = await buildCatalog();
const tips = dishes.filter((d) => d.data.featured || d.data.kind === 'main').slice(0, 4);
const sections = [
  { title: 'Tip kuchyně', id: 'tipy', dishes: tips, tip: true },
  ...r.data.sections.map((title, i) => ({ title, id: `sekce-${i + 1}`, dishes: dishes.filter((d) => d.data.section === title), tip: false })),
];
const sheetPhotos = new Map<string, { src: string; srcset: string } | null>();
for (const d of dishes) {
  const p = await photo(d.data.image);
  if (!p.meta) {
    sheetPhotos.set(d.id, null);
    continue;
  }
  const meta = p.meta;
  const ws = [560, 840].filter((w) => w <= meta.width);
  const imgs = await Promise.all(ws.map((w) => getImage({ src: meta, width: w, height: Math.round((w * 9) / 16), fit: 'cover', format: 'webp', quality: 72 })));
  sheetPhotos.set(d.id, imgs.length ? { src: imgs[0]!.src, srcset: imgs.map((x, i) => `${x.src} ${ws[i]}w`).join(', ') } : null);
}
const category = CATEGORY_LABELS[r.data.category]?.label ?? '';
const PRICE = ['', 'Kč', 'Kč Kč', 'Kč Kč Kč'];
---

<Base
  title={`${r.data.name} – fiktivní restaurace, menu nanečisto`}
  description={`${r.data.name}: smyšlená restaurace simulátoru DámeNic (${r.data.cuisine.toLowerCase()}). Objednáš nanečisto za 0 Kč, nic nepřijede, ke každému hlavnímu jídlu je recept.`}
>
  <div class="resthero">
    <div class="resthero__media">
      <Photo asset={r.data.cover} widths={[640, 960, 1280, 1600]} sizes="100vw" ratio={16 / 5} priority />
    </div>
  </div>
  <Breadcrumbs items={[{ label: 'Restaurace', href: '/restaurace/' }, { label: r.data.name }]} />
  <div class="wrap">
    <div class="resthead2">
      <Monogram logo={r.data.logo} size={72} />
      <div class="resthead2__text">
        <div class="resthead2__tags">
          <span class="tag tag--sim">Fiktivní restaurace</span>
          <span class="tag">{category}</span>
          {r.data.promo && <span class="sticker">{r.data.promo.label}</span>}
          {r.data.isNew && <span class="sticker sticker--pink">Nové</span>}
        </div>
        <h1>{r.data.name}</h1>
        <p class="resthead2__tagline">{r.data.tagline}</p>
        <ul class="pills" aria-label="Simulované údaje">
          <li><Icon name="clock" size={16} />{etaRange(r.data.etaMinutes)}</li>
          <li><Icon name="bike" size={16} />{r.data.deliveryFee === 0 || r.data.promo?.type === 'free-delivery' ? 'Dopravné 0 Kč' : `Dopravné ${formatCzk(r.data.deliveryFee)}`}</li>
          {r.data.minOrder > 0 && <li><Icon name="bag" size={16} />Min. objednávka {formatCzk(r.data.minOrder)}</li>}
          <li><Icon name="tag" size={16} />{PRICE[r.data.priceLevel]}</li>
          <li><Icon name="timer" size={16} />Otevřeno {hoursLabel(r.data.hours)}</li>
        </ul>
        <p class="small muted" style="margin:6px 0 0">
          {r.data.description} Sledování kurýra běží v reálném čase, čekání jde kdykoli přeskočit.
        </p>
      </div>
      <div class="resthead2__mode"><ModeSwitch client:idle canPickup={r.data.pickup} /></div>
    </div>

    <nav class="menunav" aria-label="Sekce menu" data-scrollspy>
      <ul class="menunav__tabs">
        {sections.map((s) => <li><a href={`#${s.id}`}>{s.title}</a></li>)}
      </ul>
      <label class="menusearch">
        <Icon name="search" size={18} />
        <span class="sr-only">Hledat v menu</span>
        <input type="search" placeholder="Hledat v menu" data-menu-search autocomplete="off" />
      </label>
    </nav>

    <div class="layout-menu">
      <div>
        {
          sections.map((s) => (
            <section class="menusec" id={s.id} aria-labelledby={`${s.id}-h`} data-menu-section>
              <h2 id={`${s.id}-h`}>{s.title}</h2>
              <ul class={s.tip ? 'tiprow' : 'menulist'}>
                {s.dishes.map((d) => {
                  const from = d.data.optionGroups.some((g) => g.required && g.options.some((o) => o.priceDelta > 0));
                  return (
                    <li class={s.tip ? 'tipcard' : 'menuitem'} data-menu-item data-name={`${d.data.name} ${d.data.description}`.toLowerCase()}>
                      <div class="menuitem__media">
                        <Photo asset={d.data.image} widths={s.tip ? [280, 420] : [140, 280]} sizes={s.tip ? '280px' : '140px'} ratio={s.tip ? 4 / 3 : 1} />
                      </div>
                      <div class="menuitem__text">
                        <h3 class="menuitem__title">{dishHasPage(d) ? <a href={`/jidla/${d.id}/`}>{d.data.name}</a> : d.data.name}</h3>
                        {!s.tip && <p class="menuitem__desc">{d.data.description}</p>}
                        <div class="menuitem__row">
                          <span class="price">
                            {from && <span class="muted small" style="font-weight:600">od </span>}
                            {formatCzk(d.data.price)}
                          </span>
                          {d.data.vegan ? <span class="tag tag--veg">Veganské</span> : d.data.vegetarian && d.data.kind === 'main' && <span class="tag tag--veg">Bez masa</span>}
                          {d.data.spicy > 0 && <span class="tag tag--hot">Pálivé {d.data.spicy}/3</span>}
                          {d.data.recipe && !s.tip && <span class="tag">Recept</span>}
                        </div>
                      </div>
                      <div class="menuitem__add">
                        <QuickAdd
                          client:visible
                          dish={catalog.dishes[d.id]!}
                          restaurant={r.data.name}
                          photo={sheetPhotos.get(d.id) ?? null}
                          description={d.data.description}
                          allergens={d.data.allergens}
                          recipeUrl={d.data.recipe ? `/recepty/${d.data.recipe.id}/` : null}
                          pageUrl={dishHasPage(d) ? `/jidla/${d.id}/` : null}
                        />
                      </div>
                    </li>
                  );
                })}
              </ul>
            </section>
          ))
        }
        <p class="menusearch__empty" hidden data-menu-empty>V menu nic takového nemáme. Což u nás nepřekvapí.</p>
        <p class="small muted" style="margin-top:22px">Všechny ceny na této stránce jsou simulované. Nic z nabídky si nelze skutečně koupit.</p>
      </div>
      <aside class="layout-menu__side" aria-label="Košík">
        <CartView client:idle variant="side" />
      </aside>
    </div>
  </div>
</Base>

<script>
  // Menu search and scrollspy: plain DOM, no framework needed.
  const input = document.querySelector<HTMLInputElement>('[data-menu-search]');
  const items = [...document.querySelectorAll<HTMLElement>('[data-menu-item]')];
  const sections = [...document.querySelectorAll<HTMLElement>('[data-menu-section]')];
  const empty = document.querySelector<HTMLElement>('[data-menu-empty]');
  const fold = (s: string) => s.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase();
  input?.addEventListener('input', () => {
    const q = fold(input.value.trim());
    for (const it of items) it.hidden = q !== '' && !fold(it.dataset.name ?? '').includes(q);
    for (const s of sections) s.hidden = q !== '' && !s.querySelector('[data-menu-item]:not([hidden])');
    if (empty) empty.hidden = q === '' || sections.some((s) => !s.hidden);
  });
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-scrollspy] a')].map((a) => [a.hash.slice(1), a]));
  const io = new IntersectionObserver(
    (entries) => {
      for (const e of entries)
        if (e.isIntersecting) {
          for (const a of links.values()) a.removeAttribute('aria-current');
          const a = links.get(e.target.id);
          a?.setAttribute('aria-current', 'true');
          a?.scrollIntoView({ block: 'nearest', inline: 'center' });
        }
    },
    { rootMargin: '-40% 0px -55% 0px' },
  );
  for (const s of sections) io.observe(s);
</script>
