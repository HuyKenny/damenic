---
import '@fontsource-variable/figtree';
// Same hashed files the CSS references: preloading them starts the font download at HTML parse time instead of after the CSS.
import figtreeLatin from '@fontsource-variable/figtree/files/figtree-latin-wght-normal.woff2?url';
import figtreeLatinExt from '@fontsource-variable/figtree/files/figtree-latin-ext-wght-normal.woff2?url';
import bricolageLatin from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-wght-normal.woff2?url';
import bricolageLatinExt from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-ext-wght-normal.woff2?url';
import '@fontsource-variable/bricolage-grotesque';
import '@/styles/global.css';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Notice from '@/islands/Notice';
import Consent from '@/islands/Consent';
import { SITE } from '@/lib/site';

interface Props {
  title: string;
  description: string;
  /** Pages with the visitor's local state are never indexed. */
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonld?: Record<string, unknown>[];
}
const { title, description, noindex = false, ogImage = '/og-default.png', ogType = 'website', jsonld = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const og = new URL(ogImage, Astro.site).href;
// Prefetch (never prerender) internal pages on hover/tap. Not for pages with live timers or for the affiliate redirect.
const speculation = JSON.stringify({
  prefetch: [
    {
      where: {
        and: [
          { href_matches: '/*' },
          { not: { href_matches: ['/go/*', '/objednavka/*', '/pokladna/*', '/kosik/*', '/hledat/*'] } },
          { not: { selector_matches: '[rel~=nofollow]' } },
        ],
      },
      eagerness: 'moderate',
    },
  ],
});
---

<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    {[figtreeLatin, figtreeLatinExt, bricolageLatin, bricolageLatinExt].map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />)}
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="cs" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={canonical} />}
    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#D92E32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:image:alt" content={fullTitle} />
    {ogImage === '/og-default.png' && <meta property="og:image:width" content="1200" />}
    {ogImage === '/og-default.png' && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <script is:inline type="speculationrules" set:html={speculation} />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
  </head>
  <body>
    <a class="skip" href="#obsah">Přeskočit na obsah</a>
    <Header />
    <main id="obsah">
      <slot />
    </main>
    <Footer />
    <Notice client:idle />
    <Consent client:idle />
  </body>
</html>
