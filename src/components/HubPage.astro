---
import Base from '@/layouts/Base.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import RecipeCard from '@/components/RecipeCard.astro';
import type { Hub } from '@/lib/hubs';
import { RECIPE_HUBS } from '@/lib/hubs';
import { SITE } from '@/lib/site';

interface Props {
  hub: Hub;
}
const { hub } = Astro.props;
// Chips link to hubs of the same kind (cuisines with cuisines, ...) so 70+ hubs do not become one wall of links.
const kind = (h: Hub) => (h.slug.includes('/') ? h.slug.split('/')[0] : 'misc');
const others = (await RECIPE_HUBS()).filter((h) => h.slug !== hub.slug && kind(h) === kind(hub));
const jsonld = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: hub.h1,
    itemListElement: hub.recipes.map((r, i) => ({ '@type': 'ListItem', position: i + 1, url: `${SITE.url}/recepty/${r.id}/`, name: r.data.title })),
  },
];
---

<Base title={hub.title} description={hub.description} jsonld={jsonld}>
  <Breadcrumbs items={[{ label: 'Recepty', href: '/recepty/' }, { label: hub.h1 }]} />
  <div class="wrap">
    <div class="pagehead prose">
      <h1>{hub.h1}</h1>
      {hub.intro.map((p) => <p>{p}</p>)}
    </div>
    <h2 class="sr-only">Recepty v této kategorii</h2>
    <div class="grid grid--dishes">
      {hub.recipes.map((r) => <RecipeCard recipe={r} />)}
    </div>
    {
      hub.filterQuery && (
        <p style="margin-top:24px">
          <a class="btn btn--ghost" href={`/recepty/${hub.filterQuery}`}>Doladit filtry: čas, strava, obtížnost</a>
        </p>
      )
    }
    <nav class="section" aria-label="Další kategorie receptů">
      <h2 style="font-size:1.25rem;margin-bottom:12px">Další recepty</h2>
      <ul class="fpanel__chips">
        {others.map((h) => <li><a class="fchip" href={h.path}>{h.label}</a></li>)}
      </ul>
    </nav>
  </div>
</Base>
