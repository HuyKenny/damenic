---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import HeaderCart from '@/islands/HeaderCart';
import CityPicker from '@/islands/CityPicker';
import Search from '@/islands/Search';

const path = Astro.url.pathname;
const links = [
  { href: '/restaurace/', label: 'Restaurace' },
  { href: '/recepty/', label: 'Recepty' },
  { href: '/moje-objednavky/', label: 'Moje objednávky' },
];
---

<p class="simstrip">
  Simulace rozvozu. Žádné skutečné platby ani doručení.<a href="/jak-to-funguje/">Jak to funguje</a>
</p>
<header class="header">
  <div class="wrap header__row">
    <Logo />
    <div class="header__tools">
      <CityPicker client:idle />
      <Search client:idle />
    </div>
    <button class="icon-btn menu-toggle" type="button" aria-expanded="false" aria-controls="hlavni-menu" data-menu-toggle>
      <Icon name="menu" /><span class="sr-only">Menu</span>
    </button>
    <nav class="header__nav" id="hlavni-menu" aria-label="Hlavní navigace">
      {links.map((l) => <a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a>)}
    </nav>
    <HeaderCart client:load />
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.getElementById('hlavni-menu');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('is-open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
