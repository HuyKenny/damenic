---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import HeaderCart from '@/islands/HeaderCart';
import CityPicker from '@/islands/CityPicker';
import Search from '@/islands/Search';

const path = Astro.url.pathname;
const tabs = [
  { href: '/', label: 'Domů', icon: 'house' as const, match: (p: string) => p === '/' },
  { href: '/restaurace/', label: 'Restaurace', icon: 'utensils' as const, match: (p: string) => p.startsWith('/restaurace/') || p.startsWith('/jidla/') },
  { href: '/recepty/', label: 'Recepty', icon: 'chef' as const, match: (p: string) => p.startsWith('/recepty/') || p === '/nakupni-seznam/' },
  { href: '/moje-objednavky/', label: 'Objednávky', icon: 'receipt' as const, match: (p: string) => p.startsWith('/moje-objednavky/') || p.startsWith('/objednavka/') },
];
---

<p class="simstrip">
  <span class="simstrip__dot" aria-hidden="true"></span>Simulace rozvozu. Žádné skutečné platby ani doručení.<a href="/jak-to-funguje/">Jak to funguje</a>
</p>
<header class="header">
  <div class="wrap header__row">
    <Logo />
    <CityPicker client:idle />
    <div class="header__search"><Search client:idle /></div>
    <nav class="header__nav" aria-label="Hlavní navigace">
      {tabs.slice(1).map((t) => <a href={t.href} aria-current={t.match(path) ? 'page' : undefined}>{t.label}</a>)}
    </nav>
    <HeaderCart client:load />
  </div>
</header>
<nav class="tabbar" aria-label="Navigace aplikace">
  {
    tabs.map((t) => (
      <a href={t.href} aria-current={t.match(path) ? 'page' : undefined}>
        <Icon name={t.icon} size={22} />
        <span>{t.label}</span>
      </a>
    ))
  }
</nav>
