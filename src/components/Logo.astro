---
// Mark drawn in Canva (smiling empty delivery bag), retraced as SVG so it stays sharp at 16 px. Wordmark is real text.
interface Props {
  variant?: 'light' | 'dark';
}
const { variant = 'light' } = Astro.props;
---

<a class:list={['logo', variant === 'dark' && 'logo--dark']} href="/" aria-label="DámeNic – úvodní stránka">
  <svg viewBox="0 0 64 64" aria-hidden="true">
    <rect width="64" height="64" rx="16" fill="#D92E32"></rect>
    <circle cx="24" cy="17" r="4" fill="#fff"></circle>
    <circle cx="40" cy="17" r="4" fill="#fff"></circle>
    <path d="M14 25 L50 25 L47 48 L42 52 L22 52 L17 48 Z" fill="#fff"></path>
    <path d="M20 26 C24 37 40 37 44 26 Z" fill="#D92E32"></path>
  </svg>
  <span class="logo__word">Dáme<b>Nic</b></span>
</a>
