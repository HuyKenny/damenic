{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Static Astro build served by Workers Static Assets. No `main` = no Worker code runs,
  // so requests are not billed. No D1/KV/cron on purpose.
  "name": "damenic",
  "compatibility_date": "2026-11-01",
  // workers.dev off: it would serve an indexable duplicate of the site.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "html_handling": "force-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "damenic.cz", "custom_domain": true },
    { "pattern": "www.damenic.cz", "custom_domain": true }
  ]
}
